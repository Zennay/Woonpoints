# Exact file allowlist for Docker COPY . . : directories must be traversable,
# but their contents are denied again before admitting reviewed files.
# Both app and worker images must NOT ingest nested local JSON/backup/secrets.
*
!Dockerfile
!package.json
!package-lock.json
!next.config.mjs
!next-env.d.ts
!tsconfig.json
!src
src/*
!src/app
src/app/*
# Admit only the reviewed web-only liveness route and required ancestors.
!src/app/api
src/app/api/*
!src/app/api/health
src/app/api/health/*
!src/app/api/health/route.ts
!src/app/globals.css
!src/app/layout.tsx
!src/app/manual-month-progress.tsx
!src/app/private-rental-scenario-budget.tsx
!src/app/position-stats.tsx
!src/app/page.tsx
!src/lib
src/lib/*
!src/lib/db-url-launcher.mjs
!src/lib/manual-month-progress.mjs
!src/lib/position-statistics.mjs
!src/lib/safety.mjs
!src/worker
src/worker/*
!src/worker/index.mjs
!prisma
prisma/*
!prisma/schema.prisma
