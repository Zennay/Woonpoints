# Deny by default: docker-compose uses a local .env for database credentials.
# Dockerfile COPY . . must never snapshot .env, private keys, .git or caches
# into reusable app/worker image layers.
*
!Dockerfile
!package*.json
!next.config.mjs
!next-env.d.ts
!tsconfig.json
!src
!src/**
!prisma
!prisma/**
!public
!public/**
# Last-match-wins: nested secrets under allowed source folders stay denied.
**/.env
**/.env.*
**/.npmrc
**/.netrc
**/*.pem
**/*.key
**/*.p12
