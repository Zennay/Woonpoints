# App/database
# Generate a unique database password and set WOONPOINTS_DB_PASSWORD only.
# Keep DATABASE_URL empty: the Compose launcher constructs the encoded URL
# inside the child process; copying the password here is unnecessary.
# Both values remain blank in this distributable example.
WOONPOINTS_DB_PASSWORD=
DATABASE_URL=

# Safety: current baseline must remain dry-run only
BOT_DRY_RUN=true

# App identity
NEXT_PUBLIC_APP_NAME="Woonpoints"
NEXT_PUBLIC_REGION="Amsterdam"

# Future integrations — leave empty until configured
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
EMAIL_FROM=
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
