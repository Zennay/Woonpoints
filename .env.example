# App/database
# First generate a unique URL-safe password; copy the same value into
# WOONPOINTS_DB_PASSWORD and the DATABASE_URL password component.
# Both lines must remain empty in this distributable example.
WOONPOINTS_DB_PASSWORD=
DATABASE_URL=

# Safety: current baseline must remain dry-run only
BOT_DRY_RUN=true

# App identity
NEXT_PUBLIC_APP_NAME="Woonpoints"
NEXT_PUBLIC_REGION="Amsterdam"

# Future integrations — leave empty until configured
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
EMAIL_FROM=
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
