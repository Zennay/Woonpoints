generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String             @id @default(cuid())
  email     String?            @unique
  createdAt DateTime           @default(now())
  accounts  WoningNetAccount[]
}

model WoningNetAccount {
  id                     String             @id @default(cuid())
  userId                 String
  label                  String
  region                 String
  authorizationGrantedAt DateTime
  pausedReason           String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferences            Preference?
  reactions              Reaction[]
  pointSnapshots         PointSnapshot[]
  workerRuns             WorkerRun[]
  auditEvents            AuditEvent[]

  @@index([userId])
}

model Preference {
  id              String            @id @default(cuid())
  accountId       String            @unique
  place           String?
  maxRentCents    Int?
  minRooms        Int?
  lotteryEnabled  Boolean           @default(false)
  minMatchPercent Int               @default(70)
  account         WoningNetAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model Reaction {
  id                String            @id @default(cuid())
  accountId         String
  listingExternalId String
  address           String?
  reactedAt         DateTime?
  closesAt          DateTime?
  registeredAt      DateTime?
  countsForMonth    Boolean?
  finalPosition     Int?
  totalReactions    Int?
  status            String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  account           WoningNetAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, listingExternalId])
  @@index([accountId, reactedAt])
}

model PointSnapshot {
  id           String            @id @default(cuid())
  accountId    String
  waitPoints   Int?
  searchPoints Int?
  capturedAt   DateTime          @default(now())
  account      WoningNetAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, capturedAt])
}

model WorkerRun {
  id         String            @id @default(cuid())
  accountId  String?
  mode       String
  status     String
  summary    Json?
  startedAt  DateTime          @default(now())
  finishedAt DateTime?
  account    WoningNetAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([accountId, startedAt])
}

model AuditEvent {
  id        String            @id @default(cuid())
  accountId String?
  type      String
  details   Json?
  createdAt DateTime          @default(now())
  account   WoningNetAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([accountId, createdAt])
}
